# ============ 数据库（本地开发用 PostgreSQL） ============
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codepilot
# 无 PostgreSQL 时可用 SQLite 快速跑通（需 pip install aiosqlite）
# DATABASE_URL=sqlite+aiosqlite:///./codepilot.db

# ============ Redis（可选） ============
# 未配置或连接失败时，缓存会自动降级为进程内内存缓存
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# ============ LLM ============
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：Embedding 走阿里云 DashScope 时需要
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 向量库 / Embedding ============
CHROMA_COLLECTION=codepilot_knowledge
# provider: local（本地 sentence-transformers 模型）| dashscope
EMBEDDING_PROVIDER=local
# 中文场景必须用中文模型；Chroma 默认的 all-MiniLM-L6-v2 是英文模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============ RAG 检索参数 ============
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVE_TOP_K=10
RERANK_TOP_K=5

# ============ 鉴权 ============
# 生产环境务必替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============ 限流 ============
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT=20/minute

# ============ HuggingFace 镜像（国内下载模型） ============
HF_ENDPOINT=https://hf-mirror.com
